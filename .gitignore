# -------------------------------------------------------------------
# Java & Maven Build Outputs
# -------------------------------------------------------------------
target/
**/target/
*.class

# Package files
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar

# Maven Wrapper (keep wrapper binaries and configs)
!mvnw
!mvnw.cmd
!**/mvnw
!**/mvnw.cmd
!.mvn/wrapper/maven-wrapper.properties
!.mvn/wrapper/maven-wrapper.jar
!**/.mvn/wrapper/maven-wrapper.properties
!**/.mvn/wrapper/maven-wrapper.jar

# -------------------------------------------------------------------
# Databases & Runtime State (Keep dataset CSVs in src/main/resources)
# -------------------------------------------------------------------
*.db
*.mv.db
*.trace.db
backend/data/
data/
!backend/src/main/resources/data/**
!src/main/resources/data/**

# -------------------------------------------------------------------
# Logs & Temporary Files
# -------------------------------------------------------------------
*.log
logs/
**/logs/
temp/
tmp/
*.tmp
*.swp
*.swo
*~

