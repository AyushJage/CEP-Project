# -------------------------------------------------------------------
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/

# Environment Variables & Secrets
.env
.env.local
.env.*.local
*.env

